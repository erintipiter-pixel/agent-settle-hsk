# HSP agent client — environment template. Copy to .env and fill in.
# NEVER commit a filled .env. Gateway URL + API key are issued by the
# hackathon organizer; until their sandbox is published, only the local
# mock coordinator values (see run-demo.sh) exist.

# Chain (HSK testnet)
HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133

# §9 REST coordinator (organizer-gated)
HSP_COORDINATOR_URL=
HSP_API_KEY=

# QA MCP gateway (IP-allowlisted by the organizer)
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/

# Deployed contracts (filled after deploy; see client/deployments.json)
SETTLEMENT_CONTRACT=
TEST_USDC_ADDRESS=

# Agent wallet key file (read in-process only, never printed)
AGENT_KEY_FILE=~/workspace/wallets/agent-evm-base.key

# Payer-side spend caps, in token base units (optional)
MAX_PER_TX_UNITS=
MAX_PER_DAY_UNITS=
